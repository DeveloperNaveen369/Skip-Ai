<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/semi_black"
    tools:context=".MainActivity">




    
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <ImageView
                android:layout_width="100dp"
                android:layout_height="70dp"

                android:layout_marginTop="10dp"
                android:src="@drawable/logo"
                >

            </ImageView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="17dp"

                    android:background="@color/white"
                    app:cardBackgroundColor="@color/semi_black"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="7dp"

                    android:id="@+id/overlya_per_view"

                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:background="@drawable/floating_border_rounded"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_margin="2dp"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Display Over Other Apps"
                            android:padding="12dp"
                            android:textColor="@color/white"
                            android:textStyle="italic"
                            android:textSize="18dp"

                            >

                        </TextView>

                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="54dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="23dp"
                            android:layout_marginHorizontal="12dp"
                            android:checkable="false"
                            android:clickable="true"
                            android:id="@+id/overlay_per_btn"
                            android:text="check"
                            app:chipIcon="@drawable/check_icon" />
                    </LinearLayout>


                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    app:cardCornerRadius="17dp"
                    android:layout_margin="17dp"
                    app:cardBackgroundColor="@color/orange"
                    app:cardElevation="7dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Accessibility Permission"
                            android:padding="12dp"
                            android:textColor="@color/white"
                            android:textStyle="italic"
                            android:textSize="18dp"

                            >

                        </TextView>

                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="54dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="23dp"
                            android:layout_marginHorizontal="12dp"
                            android:checkable="false"
                            android:clickable="true"
                            android:id="@+id/access_per_btn"
                            android:text="check"
                            app:chipIcon="@drawable/check_icon" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/floating_border_rounded"
                android:layout_margin="12dp"
                android:padding="2dp"
                android:layout_gravity="center_vertical"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="Default Translation Language"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:gravity="center"
                    android:layout_weight="2"
                    android:textColor="@color/white"
                    android:textStyle = "bold|italic"
                    android:layout_marginHorizontal="5dp"
                    >

                </TextView>

                <Spinner
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:entries="@array/languages"
                    android:layout_marginHorizontal="5dp"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/spinnerLang"
                    android:layout_weight="1"
                    android:background="@drawable/orange_rounded_border"



                    >

                </Spinner>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="14dp"
                android:orientation="horizontal"
                >
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:layout_marginHorizontal="20dp"
                    android:orientation="vertical"
                    >
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"


                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/orange"
                        >
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="15dp"
                            >
                            <com.google.android.material.chip.Chip
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                app:chipBackgroundColor="@color/black"
                                android:text="How to Use ?"
                                android:id="@+id/how_btn"
                                android:textColor="@color/white"
                                app:chipIcon="@drawable/work_alert_24px"
                                >

                            </com.google.android.material.chip.Chip>
                            <com.google.android.material.chip.Chip
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                app:chipBackgroundColor="@color/black"
                                android:text="issues ?"
                                android:gravity="center"
                                android:id="@+id/issue_btn"
                                android:textColor="@color/white"
                                app:chipIcon="@drawable/problem_24px"
                                >

                            </com.google.android.material.chip.Chip>



                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <com.google.android.material.chip.Chip
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginVertical="16dp"
                        app:chipIcon="@drawable/policy_24px"
                        android:id="@+id/terms_btn"
                        android:text="Terms &amp; Conditions">

                    </com.google.android.material.chip.Chip>



                </LinearLayout>


                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="250dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="20dp"
                    app:cardCornerRadius="12dp"
                    android:id="@+id/github_btn_card"
                    app:cardBackgroundColor="@color/semi_black"

                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:layout_gravity="center"

                        android:background="@drawable/floating_border_rounded"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:rotation="90"
                            android:text="GITHUB"
                            android:textColor="@color/white"
                            android:textSize="15dp">

                        </TextView>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/orange"
                app:cardCornerRadius="12dp"
                android:layout_margin="13dp"
                app:cardElevation="10dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"

                    android:layout_marginHorizontal="6dp"
                    >
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:background="@drawable/white_rounded_broader"
                        android:gravity="center"
                        android:hint="Paste Your API-KEY here"
                        android:id="@+id/edit_api_view"
                        android:textColorHint="@color/white"
                        android:textColor="@color/white"
                        android:textSize="17dp"
                        android:padding="4dp"
                        >

                    </EditText>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="get your open-router key, click here"
                        android:layout_marginHorizontal="5dp"

                        android:linksClickable="true"
                        android:clickable="true"
                        android:textColor="@color/white"
                        android:textStyle="italic|bold"

                        android:layout_gravity="end"
                        android:id="@+id/get_key_url"
                        android:gravity="center_vertical"

                        >

                    </TextView>


                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</LinearLayout>